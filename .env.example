# Copy to .env for local runs, or set as GitHub Actions repo secrets for CI.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=            # from @BotFather
TELEGRAM_CHAT_ID=              # your personal chat id (DM target), from @userinfobot

# --- LLM (both free tiers; Gemini primary, Groq is a fallback used only if Gemini errors) ---
GEMINI_API_KEY=                # free key: https://aistudio.google.com/apikey
GROQ_API_KEY=                  # free key: https://console.groq.com/keys
# GEMINI_MODEL=gemini-3.6-flash
# GROQ_MODEL=openai/gpt-oss-120b

# --- Tuning (all optional, defaults live in config/feeds.yaml) ---
# MECH_SCORE_THRESHOLD=
# MECH_MIN_CANDIDATES=
# MECH_MAX_CANDIDATES=
